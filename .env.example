# Copy to .env and fill in real secrets (never commit .env)
POSTGRES_USER=sniffer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=snifferdb
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
# DATABASE_URL is built by docker-compose from the above; for local runs set e.g.:
# DATABASE_URL=host=localhost port=5432 dbname=snifferdb user=sniffer password=change-me
# SNIFFER_IFACE=1
# SNIFFER_FILTER=tcp port 80
# STATS_FLUSH_MS=60000

# Stateful sensor configuration
# SNIFFER_SENSOR_ID=local
# SNIFFER_STATE_DIR=live-state
# SNIFFER_QUEUE_BYTES=67108864
# SNIFFER_API_PORT=8080
# SNIFFER_API_TOKEN=replace-with-a-random-secret
# SNIFFER_API_CONTROL_TOKEN=replace-with-a-different-secret
# SNIFFER_RETENTION_DAYS=0
