# Canonical local template lives in .env.example — copy it to .env first:
#   cp .env.example .env   (then fill in real secrets; .env is git-ignored)
# This file only documents the AWS RDS variant (production).
# AWS RDS PostgreSQL connection (fill these before running)
AWS_RDS_CONNINFO=host=<your-instance>.us-east-1.rds.amazonaws.com port=5432 dbname=snifferdb user=sniffer_admin password=<your-password> sslmode=require

# With SSL certificate verification (recommended for production)
# AWS_RDS_CONNINFO=host=<your-instance>.us-east-1.rds.amazonaws.com port=5432 dbname=snifferdb user=sniffer_admin password=<your-password> sslmode=verify-full sslrootcert=./certs/rds-ca-bundle.pem

# Local Docker fallback (optional - for development/testing)
# AWS_RDS_CONNINFO=host=localhost port=5432 dbname=snifferdb user=sniffer password=snifferpass sslmode=disable

